    "mill": { "inputs": [ "CROP" ], "outputs": [ "FLOUR" ], "seconds": 6 },
    "baker": { "inputs": [ "FLOUR", "WATER" ], "outputs": [ "BREAD" ], "seconds": 8 },
    "slaughterhouse": { "inputs": [ "PIG" ], "outputs": [ "MEAT" ], "seconds": 6 },
    "ironmelt": { "inputs": [ "IRONORE", "COAL" ], "outputs": [ "IRON" ], "seconds": 8 },
    "goldmelt": { "inputs": [ "GOLDORE", "COAL" ], "outputs": [ "GOLD" ], "seconds": 8 },
    "charcoal_burner": { "inputs": [ "PLANK" ], "outputs": [ "COAL" ], "seconds": 10 },
    "pig_farm": { "inputs": [ "CROP", "WATER" ], "outputs": [ "PIG" ], "seconds": 12 }
  },
  "gatherers": {
    "lumberjack": { "action": "CutTree", "output": "TRUNK", "workSeconds": 6, "restSeconds": 4 },
    "stonecutter": { "action": "CutStone", "output": "STONE", "workSeconds": 8, "restSeconds": 4 },
    "forester": { "action": "PlantTree", "workSeconds": 5, "restSeconds": 8 },
    "fisher": { "action": "Fish", "output": "FISH", "workSeconds": 8, "restSeconds": 6 },
    "waterworks": { "action": "DrawWater", "output": "WATER", "workSeconds": 4, "restSeconds": 4 },
    "farm": { "action": "Farm", "output": "CROP", "workSeconds": 4, "restSeconds": 4 }
  },
  "mines": {
    "coalmine": { "resource": "Coal", "output": "COAL", "seconds": 10, "radius": 3 },
    "ironmine": { "resource": "IronOre", "output": "IRONORE", "seconds": 10, "radius": 3 },
    "goldmine": { "resource": "GoldOre", "output": "GOLDORE", "seconds": 10, "radius": 3 },
    "gemsmine": { "resource": "Gems", "output": "GEMS", "seconds": 10, "radius": 3 },
    "sulfurmine": { "resource": "Sulfur", "output": "SULFUR", "seconds": 10, "radius": 3 }
  },
  "trees": { "growSeconds": 150 },
  "grain": { "growSeconds": 100 },
  "stones": { "stonesPerCut": 1 },
  "resources": {
    "_comment": "Mountains and waters: a field of the original maps holds an amount of 0-15 (mostly 8). orePerAmount/fishPerAmount = units per amount step, so a mine's stock scales with it. regenerateSeconds: a depleted field regains one step this often (0 = never).",

{
  "name": "monoSettlers",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // Runtimes (dotnet, node, bun) come from .mise.toml.
    "ghcr.io/devcontainers-extra/features/mise:1": {
      "version": "2026.9.12"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {},
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // devcontainer substitution has no nested defaults, so a host symlink picks the mount source: HOMESTEAD_GAME_DIR if set,
  // else an empty dir (a bind source must exist).
  "initializeCommand": "mkdir -p .devcontainer/no-game && ln -sfn \"${HOMESTEAD_GAME_DIR:-$PWD/.devcontainer/no-game}\" .devcontainer/game-dir",
  "mounts": [
    // Original game installation, read-only, from the same variable the game itself reads (.devcontainer/game-dir -> /mnt/settlers3).
    "source=${localWorkspaceFolder}/.devcontainer/game-dir,target=/mnt/settlers3,type=bind,readonly",
    // mise installs and the NuGet global-packages folder live on named volumes: they survive rebuilds.
    "source=mise-data-volume,target=/mnt/mise-data,type=volume",
    "source=nuget-cache-volume,target=/mnt/nuget-cache,type=volume"
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "runArgs": ["--memory=8gb"],
  // Named volumes are docker-created root-owned; bun/opencode install into ~/.local and ~/.opencode.
  // The bun + opencode curl|bash installers float deliberately (self-updating channels, no version contract to pin).
  "onCreateCommand": "sudo mkdir -p /home/vscode/.local /mnt/mise-data /mnt/nuget-cache && sudo chown -R vscode:vscode /home/vscode/.local /mnt/mise-data /mnt/nuget-cache && export PATH=\"/mnt/mise-data/shims:$PATH\" && mise trust \"$(pwd)/.mise.toml\" && mise install && for i in 1 2 3 4 5; do curl -fsSL https://opencode.ai/v2/install | bash && break; [ \"$i\" = 5 ] && exit 1; sleep $((i * 5)); done && sudo ln -sf /home/vscode/.opencode/bin/opencode /usr/local/bin/opencode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // mise-trust covers this worktree's path (trust state persists on the mise-data volume).
  "postStartCommand": "export PATH=\"/mnt/mise-data/shims:$PATH\"; mise trust \"$(pwd)/.mise.toml\" >/dev/null 2>&1 || true; bash .devcontainer/set-git-identity.sh || true; bash .devcontainer/link-game-dir.sh || true",
  "containerEnv": {
    // Agent shells run under a PTY: git/gh pagers block forever without these.
    "GIT_PAGER": "cat",
    "GH_PAGER": "cat",
    // This repo is a fork: gh would otherwise default PRs/issues to the upstream project.
    "GH_REPO": "L-Sypniewski/monogameSettlers",
    "MISE_DATA_DIR": "/mnt/mise-data",
    // containerEnv does not expand ${containerEnv:PATH}, so the image PATH is spelled out.
    "NUGET_PACKAGES": "/mnt/nuget-cache/packages",
    "DOTNET_NOLOGO": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
    "PATH": "/home/vscode/.opencode/bin:/mnt/mise-data/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  // Credentials are forwarded from the host shell environment (see README.md); unset ones stay empty.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "anthropic.claude-code"
      ]
    }
  }
}

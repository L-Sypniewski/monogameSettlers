# Fork-only paths: never ported (git pathspec-style, one per line).
# A commit touching ONLY these is fork tooling (skipped by port-upstream.sh);
# a commit mixing these with shared paths fails the port (split it first).
.agents/
.claude/
.opencode/
.devcontainer/
.plans/
docs/sessions/
docs/reviews/
.mise.toml
.shipflow.json
.herdr-workflow.json
AGENTS.md
opencode.jsonc
skills-lock.json
scripts/check-skills-lock.ts
scripts/fast-checks.sh

# Shared files whose entire fork-side delta is fork-only content: a commit touching
# only these files (with or without fork-only paths) is also tooling and is skipped -
# upstream-able changes to these files must be submitted directly upstream; the skip
# log is the signal. The marker lines below describe that content; the port asserts
# on its absence.
owned .github/workflows/build.yml
owned .gitignore

# Shared files with fork-only content: fixed strings that must NOT appear on a port branch.
marker .github/workflows/build.yml oven-sh/setup-bun
marker .github/workflows/build.yml Skills lock
marker .github/workflows/build.yml scripts/check-skills-lock.ts
marker .gitignore # Devcontainer / shipflow local state
marker .gitignore .devcontainer/.env
marker .gitignore .opencode/node_modules/
marker .gitignore .devcontainer/no-game/
marker .gitignore .devcontainer/game-dir
